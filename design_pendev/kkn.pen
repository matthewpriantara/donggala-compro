                            },
                            {
                              "type": "text",
                              "id": "vH6GZ",
                              "name": "Kecamatan Kabola adalah salah satu kecam",
                              "context": "p",
                              "fill": "#1a2d3da6",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 78,
                              "content": "Kecamatan Kabola adalah salah satu kecamatan di Kabupaten Alor, Provinsi Nusa Tenggara Timur. Berada di ketinggian dengan panorama alam yang dramatis, kecamatan ini mencakup wilayah daratan dan pesisir yang kaya akan keanekaragaman hayati dan budaya.",
                              "lineHeight": 1.63,
                              "fontFamily": "satoshi",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "FCzyo",
                          "name": "Wilayah ini dihuni oleh masyarakat yang ",
                          "context": "p",
                          "fill": "#1a2d3da6",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 52,
                          "content": "Wilayah ini dihuni oleh masyarakat yang menjaga tradisi leluhur sambil terus beradaptasi, mulai dari petani lokal hingga pengrajin tenun ikat, dari nelayan tradisional hingga pemandu wisata yang mulai mengenalkan keindahan Kabola ke dunia.",
                          "lineHeight": 1.63,
                          "fontFamily": "satoshi",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        },
