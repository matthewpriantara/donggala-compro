        },
        {
          "type": "text",
          "id": "snr0D",
          "name": "WhatsApp implementation behavior",
          "fill": "$jelajah-navy",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Implementasi berikutnya: tombol membuka wa.me/{nomor_admin}?text={pesan_terenkode}. Gunakan hanya kontak pengelola yang disetujui. Pesan berisi nama kegiatan dan pilihan jadwal, bukan data pribadi tersembunyi. Pengunjung tetap menekan Kirim di WhatsApp. Membuka WhatsApp bukan pesan terkirim dan bukan reservasi terkonfirmasi.",
          "lineHeight": 1.4,
          "fontFamily": "DM Sans",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "O6IA2s",
          "name": "Repeated event slug behavior",
          "fill": "$jelajah-navy",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Slug /aktivitas/{slug} stabil untuk tiap jenis kegiatan. Keberangkatan/jadwal berulang disimpan sebagai occurrence terpisah dan dipilih pada halaman, bukan membuat nama aktivitas baru setiap bulan. Jika perlu tautan jadwal langsung, gunakan parameter ID jadwal, bukan menebak tanggal tersedia.",
          "lineHeight": 1.4,
          "fontFamily": "DM Sans",
          "fontSize": 16,
          "fontWeight": "normal"
        }
      ]
    },
